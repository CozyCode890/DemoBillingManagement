#!/bin/bash
# =====================================================================
#  Setup.app/Contents/MacOS/Setup
#  Launcher 1-click cho macOS -- bản tương đương Setup.exe của Windows.
# ---------------------------------------------------------------------
#  Người dùng bấm đúp Setup.app trong Finder, macOS chạy đúng file này.
#  Nó chỉ lo một việc: có JDK 21 để chạy SetupApp.jar. Mọi việc còn lại
#  (thư viện, MySQL, database, biên dịch, mở app) do SetupApp.jar làm.
#
#    1. Tìm thư mục gốc dự án (đi ngược lên từ vị trí Setup.app).
#    2. Tìm JDK >= 21 (phải có javac): JDK portable của công cụ, JAVA_HOME,
#       /usr/libexec/java_home, thư mục cài của các hãng, Homebrew.
#    3. Không có thì TỰ TẢI Temurin 21 (~190 MB) về $RB_HOME/jdk bằng curl.
#       Không cần Homebrew, không cần mật khẩu admin.
#    4. Chép SetupApp.jar sang $RB_HOME/app rồi chạy bản chép (repo đổi
#       nhánh thoải mái trong lúc app đang mở), truyền -Drb.project.root.
#
#  $RB_HOME = $RETAIL_BILLING_HOME nếu có, không thì ~/.retail-billing --
#  PHẢI giống envsetup.core.DevHome trong SetupApp.
#
#  QUAN TRỌNG khi sửa file: macOS chỉ có bash 3.2 (bản 2007). Không dùng
#  mảng kết hợp (declare -A), ${bien,,} hay mapfile -- bash 3.2 không hiểu.
# =====================================================================

set -u

MIN_JAVA_MAJOR=21
APP_NAME="Retail Billing Setup"
DOWNLOAD_PAGE="https://adoptium.net/temurin/releases/?version=21&os=mac"
RB_HOME="${RETAIL_BILLING_HOME:-$HOME/.retail-billing}"

# --- Vị trí các thư mục ----------------------------------------------
HERE="$(cd "$(dirname "$0")" && pwd)"            # .../Setup.app/Contents/MacOS
APP_BUNDLE="$(cd "$HERE/../.." && pwd)"          # .../Setup.app
RESOURCES="$APP_BUNDLE/Contents/Resources"
LOG="${TMPDIR:-/tmp}/retail-billing-setup.log"

# ---------------------------------------------------------------------
#  Hộp thoại -- nội dung đi qua argv của AppleScript chứ không nhét vào
#  chuỗi lệnh, để đường dẫn có dấu nháy / tiếng Việt không làm hỏng cú pháp.
# ---------------------------------------------------------------------

show_error() { # $1 = nội dung
    /usr/bin/osascript \
        -e 'on run argv' \
        -e 'display dialog (item 1 of argv) with title (item 2 of argv) buttons {"Đóng"} default button 1 with icon stop' \
        -e 'end run' \
        "$1" "$APP_NAME" >/dev/null 2>&1
}

ask_two_way() { # $1 = nội dung, $2 $3 = nhãn hai nút; in ra nút được bấm
    /usr/bin/osascript \
        -e 'on run argv' \
        -e 'set r to display dialog (item 1 of argv) with title (item 2 of argv) buttons {item 3 of argv, item 4 of argv} default button 2 with icon caution' \
        -e 'return button returned of r' \
        -e 'end run' \
        "$1" "$APP_NAME" "$2" "$3" 2>/dev/null
}

# ---------------------------------------------------------------------
#  Tìm thư mục gốc dự án (giống envsetup.core.Project)
# ---------------------------------------------------------------------

find_project_root() {
    local dir="$1"
    local i
    for ((i = 0; i < 5; i++)); do
        if [ -f "$dir/config.properties" ] || [ -f "$dir/SetupApp.jar" ]; then
            echo "$dir"
            return 0
        fi
        [ "$dir" = "/" ] && break
        dir="$(dirname "$dir")"
    done
    return 1
}

ROOT="$(find_project_root "$(dirname "$APP_BUNDLE")")"
if [ -z "$ROOT" ]; then
    show_error "Không tìm thấy thư mục dự án.

Setup.app phải nằm ngay trong thư mục gốc của repo (cạnh config.properties và SetupApp.jar).

Nếu bạn đã kéo Setup.app sang Applications hoặc Desktop, hãy chuyển nó về lại thư mục dự án."
    exit 1
fi

JAR="$ROOT/SetupApp.jar"
if [ ! -f "$JAR" ]; then
    show_error "Không tìm thấy SetupApp.jar trong:
$ROOT"
    exit 1
fi

# ---------------------------------------------------------------------
#  Tìm JDK
# ---------------------------------------------------------------------
# KHÔNG kiểm tra bằng "command -v java": /usr/bin/java luôn tồn tại kể cả khi
# máy chưa cài JDK (vỏ rỗng của Apple, chạy vào là bật popup của hệ thống).

java_major() {
    local home="$1" version=""
    if [ -r "$home/release" ]; then
        version="$(/usr/bin/sed -n 's/^JAVA_VERSION="\{0,1\}\([^"]*\)".*/\1/p' "$home/release" | head -1)"
    fi
    [ -z "$version" ] && return 1
    case "$version" in
        1.*) echo "$version" | cut -d. -f2 ;;
        *)   echo "$version" | cut -d. -f1 | cut -d- -f1 ;;
    esac
}

collect_java_homes() {
    echo "$RB_HOME/jdk/Contents/Home"
    [ -n "${JAVA_HOME:-}" ] && echo "$JAVA_HOME"
    if [ -x /usr/libexec/java_home ]; then
        /usr/libexec/java_home -v "${MIN_JAVA_MAJOR}+" 2>/dev/null
    fi
    local dir
    for dir in /Library/Java/JavaVirtualMachines/*/Contents/Home \
               "$HOME/Library/Java/JavaVirtualMachines"/*/Contents/Home \
               /opt/homebrew/opt/openjdk*/libexec/openjdk.jdk/Contents/Home \
               /usr/local/opt/openjdk*/libexec/openjdk.jdk/Contents/Home; do
        [ -d "$dir" ] && echo "$dir"
    done
}

# process substitution: vòng lặp chạy trong shell hiện tại nên giữ được biến.
BEST_HOME=""
BEST_MAJOR=0
find_best_jdk() {
    BEST_HOME=""
    BEST_MAJOR=0
    local home major
    while IFS= read -r home; do
        [ -n "$home" ] && [ -x "$home/bin/java" ] && [ -x "$home/bin/javac" ] || continue
        major="$(java_major "$home")" || continue
        case "$major" in ''|*[!0-9]*) continue ;; esac
        if [ "$major" -ge "$MIN_JAVA_MAJOR" ] && [ "$major" -gt "$BEST_MAJOR" ]; then
            BEST_MAJOR="$major"
            BEST_HOME="$home"
        fi
    done < <(collect_java_homes)
}

# ---------------------------------------------------------------------
#  Tải JDK portable
# ---------------------------------------------------------------------

download_jdk() {
    local arch url downloads archive tmp inner dialog_pid curl_pid
    case "$(uname -m)" in
        arm64) arch="aarch64" ;;
        *)     arch="x64" ;;
    esac
    url="https://api.adoptium.net/v3/binary/latest/21/ga/mac/$arch/jdk/hotspot/normal/eclipse?project=jdk"
    downloads="$RB_HOME/downloads"
    archive="$downloads/temurin-21-jdk-mac-$arch.tar.gz"
    mkdir -p "$downloads" || return 1

    # Hộp thoại "đang tải" chạy nền; người dùng bấm Huỷ thì dừng curl.
    /usr/bin/osascript \
        -e 'on run argv' \
        -e 'display dialog (item 1 of argv) with title (item 2 of argv) buttons {"Huỷ tải"} default button 1 giving up after 1800' \
        -e 'end run' \
        "Máy chưa có Java 21 -- đang tự tải bản portable (~190 MB, chỉ một lần, không cần cài đặt).

Setup App sẽ tự mở khi tải xong." "$APP_NAME" >"$downloads/dialog.out" 2>&1 &
    dialog_pid=$!

    if [ ! -f "$archive" ]; then
        /usr/bin/curl -fL --retry 3 -C - -o "$archive.part" "$url" >>"$LOG" 2>&1 &
        curl_pid=$!
        while kill -0 "$curl_pid" 2>/dev/null; do
            # Chỉ coi là huỷ khi thật sự có nút được bấm ("button returned:Huỷ tải");
            # hộp thoại hết giờ ("gave up") hoặc không hiện được thì cứ tải tiếp.
            if ! kill -0 "$dialog_pid" 2>/dev/null && grep -q "button returned:H" "$downloads/dialog.out" 2>/dev/null; then
                kill "$curl_pid" 2>/dev/null
                wait "$curl_pid" 2>/dev/null
                return 2        # người dùng bấm Huỷ tải
            fi
            sleep 1
        done
        if ! wait "$curl_pid"; then
            kill "$dialog_pid" 2>/dev/null
            return 1
        fi
        mv "$archive.part" "$archive" || return 1
    fi

    tmp="$RB_HOME/jdk.tmp"
    rm -rf "$tmp" && mkdir -p "$tmp"
    if ! /usr/bin/tar -xzf "$archive" -C "$tmp" >>"$LOG" 2>&1; then
        rm -f "$archive"        # file hỏng -- lần sau tải lại
        kill "$dialog_pid" 2>/dev/null
        return 1
    fi
    inner="$(ls -d "$tmp"/*/Contents/Home 2>/dev/null | head -1)"
    if [ -z "$inner" ]; then
        kill "$dialog_pid" 2>/dev/null
        return 1
    fi
    rm -rf "$RB_HOME/jdk"
    mv "$(dirname "$(dirname "$inner")")" "$RB_HOME/jdk"
    rm -rf "$tmp" "$archive"
    kill "$dialog_pid" 2>/dev/null
    return 0
}

{
    echo "=== $(date '+%Y-%m-%d %H:%M:%S') khởi chạy Setup App ==="
    echo "Thư mục dự án : $ROOT"
    echo "RB_HOME       : $RB_HOME"
} > "$LOG"

find_best_jdk
if [ -z "$BEST_HOME" ]; then
    download_jdk
    case $? in
        0) find_best_jdk ;;
        2) exit 1 ;;
        *)
            ANSWER="$(ask_two_way "Không tải được Java 21 (kiểm tra kết nối mạng rồi mở lại Setup.app -- phần đã tải được giữ lại).

Nhật ký: $LOG" "Đóng" "Mở trang tải")"
            [ "$ANSWER" = "Mở trang tải" ] && /usr/bin/open "$DOWNLOAD_PAGE"
            exit 1
            ;;
    esac
    if [ -z "$BEST_HOME" ]; then
        show_error "Đã tải Java nhưng không dùng được. Nhật ký: $LOG"
        exit 1
    fi
fi

# ---------------------------------------------------------------------
#  Chạy SetupApp.jar (bản chép trong $RB_HOME/app)
# ---------------------------------------------------------------------

RUN_JAR="$JAR"
SUM="$(/usr/bin/shasum "$JAR" 2>/dev/null | cut -c1-12)"
if [ -n "$SUM" ] && mkdir -p "$RB_HOME/app" 2>/dev/null; then
    COPY="$RB_HOME/app/SetupApp-$SUM.jar"
    if [ -f "$COPY" ] || { cp "$JAR" "$COPY.tmp.$$" 2>/dev/null && mv "$COPY.tmp.$$" "$COPY"; }; then
        RUN_JAR="$COPY"
        for old in "$RB_HOME"/app/SetupApp-*.jar; do
            [ "$old" = "$COPY" ] || rm -f "$old"
        done
    fi
fi

export JAVA_HOME="$BEST_HOME"
export PATH="$BEST_HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$ROOT" || exit 1
echo "JAVA_HOME     : $JAVA_HOME (Java $BEST_MAJOR)" >> "$LOG"
echo "Jar           : $RUN_JAR" >> "$LOG"

# -Xdock đặt tên và icon trên Dock; thiếu nó app hiện tên "java" với icon cốc cà phê.
"$BEST_HOME/bin/java" \
    -Dfile.encoding=UTF-8 \
    "-Drb.project.root=$ROOT" \
    -Dapple.awt.application.name="$APP_NAME" \
    -Xdock:name="$APP_NAME" \
    -Xdock:icon="$RESOURCES/Setup.icns" \
    -jar "$RUN_JAR" "$@" >> "$LOG" 2>&1
STATUS=$?

if [ $STATUS -ne 0 ]; then
    if /usr/bin/grep -q "Operation not permitted\|Unable to access jarfile" "$LOG" 2>/dev/null; then
        # macOS chặn app đọc thư mục Desktop / Documents / Downloads (TCC).
        ANSWER="$(ask_two_way "macOS không cho Setup App đọc thư mục dự án (đang nằm trong Desktop / Documents / Downloads).

Cách sửa nhanh nhất: chuyển thư mục dự án vào thư mục cá nhân ($HOME), rồi bấm đúp Setup.app lại.
Hoặc bấm 'Mở bằng Terminal' -- Terminal được hỏi cấp quyền một lần." "Đóng" "Mở bằng Terminal")"
        if [ "$ANSWER" = "Mở bằng Terminal" ]; then
            /usr/bin/osascript \
                -e 'on run argv' \
                -e 'tell application "Terminal" to do script ("cd " & quoted form of (item 1 of argv) & " && " & quoted form of (item 2 of argv) & " \"-Drb.project.root=" & (item 1 of argv) & "\" -jar SetupApp.jar")' \
                -e 'tell application "Terminal" to activate' \
                -e 'end run' \
                "$ROOT" "$BEST_HOME/bin/java" >/dev/null 2>&1
            exit 0
        fi
        exit $STATUS
    fi
    show_error "Setup App đóng bất thường (mã lỗi $STATUS).

$(tail -n 12 "$LOG")

Nhật ký đầy đủ: $LOG"
fi

exit $STATUS
